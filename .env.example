# Buglasan AI - Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env files to version control

# ============================================
# Supabase Configuration
# ============================================
# Get these from your Supabase project dashboard: Settings > API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Server-side tooling aliases (never expose the service-role key to Vite/client code)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# For server-side Edge Functions (not exposed to client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# LIVE RAG smoke harness safety gates. The expected ref must exactly match
# the subdomain in SUPABASE_URL. Set the opt-in only for an intentional run.
SUPABASE_EXPECTED_PROJECT_REF=your-project-ref
# LIVE_RAG_SMOKE_TEST=I_UNDERSTAND_THIS_WRITES_TO_PRODUCTION

# ============================================
# Gemini API Configuration
# ============================================
# Get your API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Optional: Override default model (default: gemini-1.5-flash)
# GEMINI_MODEL=gemini-1.5-flash

# Optional: Override default embedding model (default: gemini-embedding-001)
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# ============================================
# Application Configuration
# ============================================
# Default festival year (defaults to current year in Asia/Manila)
# VITE_DEFAULT_FESTIVAL_YEAR=2026

# Timezone for date resolution (default: Asia/Manila)
# VITE_TIMEZONE=Asia/Manila

# Enable/disable demo mode with synthetic data (default: true for development)
# VITE_DEMO_MODE=true

# ============================================
# Optional: Analytics & Monitoring
# ============================================
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# SENTRY_DSN=https://xxx@sentry.io/xxx
