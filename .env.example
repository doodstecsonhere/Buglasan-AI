# Buglasan AI - Environment Variables
# Copy this file to .env.local and fill in your values
# NEVER commit .env files to version control

# ============================================
# Supabase Configuration
# ============================================
# Get these from your Supabase project dashboard: Settings > API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Vite explicitly exposes only this publishable key to the browser.
SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here

# Server-side tooling URL (unchanged)
SUPABASE_URL=https://your-project-ref.supabase.co

# Trusted local/server scripts and n8n only; never expose to Vite/client code.
SUPABASE_SECRET_KEY=your-secret-key-here
# Hosted Edge Functions instead use the default entry in the automatically
# provided SUPABASE_SECRET_KEYS JSON dictionary. Do not set it manually.

# LIVE RAG smoke harness safety gates. The expected ref must exactly match
# the subdomain in SUPABASE_URL. Set the opt-in only for an intentional run.
SUPABASE_EXPECTED_PROJECT_REF=your-project-ref
# LIVE_RAG_SMOKE_TEST=I_UNDERSTAND_THIS_WRITES_TO_PRODUCTION
# Phase 5 source collector harness uses the same project-ref guard and a separate opt-in.
# LIVE_SOURCE_COLLECTOR_TEST=I_UNDERSTAND_THIS_WRITES_TO_PRODUCTION
# Workflow B trusted request token. Configure only in n8n and the Edge Function.
# EXTRACT_SOURCE_TOKEN=generate-a-long-random-server-only-token
# Acceptance-only deterministic fixtures are disabled unless a separate server-only token is configured.
# EXTRACTION_ACCEPTANCE_FIXTURE_TOKEN=generate-a-different-long-random-server-only-token
# Extractor state version; bump when prompt/contract semantics change.
# EXTRACTOR_VERSION=phase6-v1
# LIVE_KNOWLEDGE_EXTRACTION_TEST=I_UNDERSTAND_THIS_WRITES_TO_PRODUCTION

# ============================================
# Gemini API Configuration
# ============================================
# Get your API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Optional: Override default model (default: gemini-flash-latest)
# GEMINI_MODEL=gemini-flash-latest

# Optional: Override default embedding model (default: gemini-embedding-001)
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# ============================================
# Application Configuration
# ============================================
# Default festival year (defaults to current year in Asia/Manila)
# VITE_DEFAULT_FESTIVAL_YEAR=2026

# Timezone for date resolution (default: Asia/Manila)
# VITE_TIMEZONE=Asia/Manila

# Enable/disable demo mode with synthetic data (default: true for development)
# VITE_DEMO_MODE=true

# ============================================
# Optional: Analytics & Monitoring
# ============================================
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# SENTRY_DSN=https://xxx@sentry.io/xxx
