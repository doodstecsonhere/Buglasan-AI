    {"id":"source-id-trigger","name":"Trusted Source ID Trigger","type":"n8n-nodes-base.webhook","typeVersion":2,"position":[0,0],"parameters":{"httpMethod":"POST","path":"buglasan-knowledge-extractor","authentication":"headerAuth","responseMode":"responseNode","options":{}},"credentials":{"httpHeaderAuth":{"id":"configure-after-import","name":"Buglasan extraction webhook token"}}},
    {"id":"validate","name":"Validate Exact Source ID","type":"n8n-nodes-base.code","typeVersion":2,"position":[220,0],"parameters":{"jsCode":"const b=$json.body??$json;if(!b||typeof b!=='object'||Array.isArray(b)||Object.keys(b).length!==1||typeof b.source_id!=='string'||!/^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i.test(b.source_id)) return [];return [{json:{source_id:b.source_id}}];"}},
    {"id":"extract-source-call","name":"Call Trusted Extract Source Once","type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[440,0],"parameters":{"method":"POST","url":"={{ $env.SUPABASE_URL + '/functions/v1/extract-source' }}","sendHeaders":true,"headerParameters":{"parameters":[{"name":"x-extraction-token","value":"={{ $env.EXTRACT_SOURCE_TOKEN }}"}]},"sendBody":true,"specifyBody":"json","jsonBody":"={{ { source_id: $json.source_id } }}","options":{"timeout":95000,"response":{"response":{"neverError":true,"responseFormat":"json"}}}}},
    {"id":"normalize-status","name":"Normalize Safe Extraction Status","type":"n8n-nodes-base.code","typeVersion":2,"position":[660,0],"parameters":{"jsCode":"const r=$json.body??$json;const status=typeof r?.status==='string'?r.status:'permanent_error';return [{json:{status,accepted:true,candidate_event_ids:[],has_more_candidates:false,remaining_candidate_count:0}}];"}},
