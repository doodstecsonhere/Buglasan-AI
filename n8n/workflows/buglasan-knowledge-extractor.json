    {"id":"dispatch-plan","name":"Get Safe Candidate Dispatch Plan","type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[900,0],"parameters":{"method":"POST","url":"={{ $env.SUPABASE_URL + '/rest/v1/rpc/get_orchestration_dispatch' }}","sendHeaders":true,"headerParameters":{"parameters":[{"name":"apikey","value":"={{ $env.SUPABASE_SECRET_KEY }}"},{"name":"Content-Type","value":"application/json"}]},"sendBody":true,"contentType":"raw","rawContentType":"application/json","body":"={{ JSON.stringify({p_source_id:$node['Validate Exact Source ID'].json.source_id,p_changed:false}) }}","options":{"response":{"response":{"responseFormat":"json"}}}}},
    {"id":"validate-dispatch-plan","name":"Validate Candidate Dispatch Plan","type":"n8n-nodes-base.code","typeVersion":2,"position":[1080,0],"parameters":{"jsCode":"const p=$json.body??$json;if(!p||typeof p!=='object'||Array.isArray(p)||typeof p.source_id!=='string'||!Array.isArray(p.candidate_event_ids)||!p.candidate_event_ids.every(id=>typeof id==='string'&&/^[0-9a-f-]{36}$/i.test(id))||typeof p.has_more_candidates!=='boolean'||!Number.isInteger(p.remaining_candidate_count)||p.remaining_candidate_count<0)throw new Error('Malformed orchestration dispatch plan');return [{json:{...p,status:'extracted',accepted:true}}];"}},
