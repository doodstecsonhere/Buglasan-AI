    {"id":"candidate-items","name":"Emit Safe Current Candidate IDs","type":"n8n-nodes-base.code","typeVersion":2,"position":[1260,80],"parameters":{"jsCode":"return $json.candidate_event_ids.map(candidate_event_id=>({json:{candidate_event_id}}));"}},
