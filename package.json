{
  "name": "buglasan-ai",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "smoke:rag:live": "node --experimental-strip-types scripts/seed-smoke-test.ts --acceptance",
    "smoke:rag:cleanup": "node --experimental-strip-types scripts/seed-smoke-test.ts --cleanup",
    "source:acceptance": "node --experimental-strip-types scripts/source-collector-live.ts --acceptance",
    "source:cleanup": "node --experimental-strip-types scripts/source-collector-live.ts --cleanup",
    "extraction:acceptance": "node --experimental-strip-types scripts/knowledge-extraction-live.ts --acceptance",
    "extraction:cleanup": "node --experimental-strip-types scripts/knowledge-extraction-live.ts --cleanup",
    "check:extraction-json": "node -e \"JSON.parse(require('fs').readFileSync('n8n/workflows/buglasan-knowledge-extractor.json'));JSON.parse(require('fs').readFileSync('test/fixtures/extraction-test-cases.json'));console.log('Extraction JSON valid')\"",
    "indexing:acceptance": "node --experimental-strip-types scripts/semantic-indexing-live.ts --acceptance",
    "indexing:cleanup": "node --experimental-strip-types scripts/semantic-indexing-live.ts --cleanup",
    "check:indexing-json": "node -e \"JSON.parse(require('fs').readFileSync('n8n/workflows/buglasan-semantic-indexer.json'));console.log('Semantic indexing JSON valid')\"",
    "reconciliation:acceptance": "node --experimental-strip-types scripts/event-reconciliation-live.ts --acceptance",
    "reconciliation:cleanup": "node --experimental-strip-types scripts/event-reconciliation-live.ts --cleanup",
    "check:reconciliation-json": "node -e \"JSON.parse(require('fs').readFileSync('n8n/workflows/buglasan-event-reconciler.json'));console.log('Event reconciliation JSON valid')\"",
    "check:orchestration-json": "node -e \"for(const f of ['n8n/workflows/buglasan-source-collector.json','n8n/workflows/buglasan-knowledge-extractor.json','n8n/workflows/buglasan-semantic-indexer.json','n8n/workflows/buglasan-event-reconciler.json'])JSON.parse(require('fs').readFileSync(f));console.log('Orchestration JSON valid')\"",
    "pipeline:status": "node --experimental-strip-types scripts/orchestration-status.ts",
    "orchestration:status": "npm run pipeline:status",
    "orchestration:live": "node --experimental-strip-types scripts/orchestration-live.ts",
    "orchestration:acceptance": "node --experimental-strip-types scripts/orchestration-live.ts --acceptance",
    "pipeline:acceptance": "node --env-file=.env.local --experimental-strip-types scripts/orchestration-live.ts --acceptance",
    "pipeline:diagnostic-chat": "node --env-file=.env.local --experimental-strip-types scripts/orchestration-live.ts --diagnostic-chat",
    "pipeline:cleanup": "node --experimental-strip-types scripts/orchestration-live.ts --cleanup"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/ui": "^3.2.4",
    "autoprefixer": "^10.5.4",
    "jsdom": "^25.0.0",
    "oxlint": "^1.79.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vitest": "^3.2.4"
  }
}
